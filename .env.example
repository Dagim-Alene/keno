# Copy this file to .env and fill in your values
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/keno
PORT=3000

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Admin token for approving/rejecting withdrawals (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_TOKEN=

# HMAC secret for payment webhook verification
PAYMENT_WEBHOOK_SECRET=

# Comma-separated ISO 3166-1 alpha-2 country codes to block
BLOCKED_COUNTRIES=

# Session secret for signed cookies (if you add session middleware later)
SESSION_SECRET=

# Game limits (in cents, 100 = $1.00)
MAX_BET_CENTS=10000
DAILY_LOSS_LIMIT_CENTS=50000
MIN_BET_CENTS=100

# Starting balance for new users (in cents)
INITIAL_BALANCE_CENTS=100000

# Rate limits
PLAY_RATE_LIMIT_WINDOW_MS=60000
PLAY_RATE_LIMIT_MAX=30

# Minimum age for players
MIN_AGE_YEARS=18

# Node environment
NODE_ENV=development
