# Copy this file to .env and fill in your values
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/keno
PORT=3000

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# Admin token for approving/rejecting withdrawals & deposits (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_TOKEN=

# HMAC secret for payment webhook verification
PAYMENT_WEBHOOK_SECRET=

# Comma-separated ISO 3166-1 alpha-2 country codes to block
BLOCKED_COUNTRIES=

# Session secret for signed cookies
SESSION_SECRET=

# Game limits (in cents, 100 = 1.00 ETB)
MAX_BET_CENTS=100000
# Default daily loss limit: 0 or unset means NO forced daily loss limit.
# Note: Regulators may require responsible gaming limit tools to remain available to players (via POST /api/user/limits).
DEFAULT_DAILY_LOSS_LIMIT_CENTS=0
MIN_BET_CENTS=100

# Starting balance for new users (in cents, 100000 = 1000.00 ETB)
INITIAL_BALANCE_CENTS=100000

# Live Round Schedule Timing (in seconds)
BETTING_DURATION_S=25
LOCKED_DURATION_S=3
DRAWING_DURATION_S=10
RESULT_DURATION_S=5

# House Protection Limits (in cents)
MAX_PAYOUT_PER_TICKET_CENTS=1000000
MAX_TOTAL_PAYOUT_PER_ROUND_CENTS=5000000
MAX_TICKETS_PER_ROUND=3

# Deposit Limits & Expiry
DEPOSIT_MIN_CENTS=1000
DEPOSIT_MAX_CENTS=10000000
DEPOSIT_MAX_PENDING=3
DEPOSIT_EXPIRY_HOURS=24

# Withdrawal Turnover Multiplier (0 to disable)
WITHDRAWAL_TURNOVER_MULTIPLIER=0

# Rate limits
PLAY_RATE_LIMIT_WINDOW_MS=60000
PLAY_RATE_LIMIT_MAX=30

# Minimum age for players
MIN_AGE_YEARS=18

# Trust proxy (1 for Cloudflare/Render)
TRUST_PROXY=1

# Node environment
NODE_ENV=development
